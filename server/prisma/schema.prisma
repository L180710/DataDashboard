generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model City {
  id        Int      @id @default(autoincrement())
  cityId    String   @unique
  name      String
  longitude Float
  latitude  Float
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
