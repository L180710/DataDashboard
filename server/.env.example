# ===== 数据库 =====
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 本地示例：mysql://root:你的密码@localhost:3306/data_dashboard
DATABASE_URL="mysql://root:your_password@localhost:3306/data_dashboard"

# 如果代码用下面这些拆分变量，请与 DATABASE_URL 保持一致
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=data_dashboard

# ===== 服务 =====
PORT=3000
